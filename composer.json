{
    "name": "convis/cachetool",
    "description": "Manage your OPcache & APCu cache through the CLI",
    "keywords": [
        "cache",
        "opcache",
        "apcu",
        "fastcgi",
        "opcode",
        "fpm"
    ],
    "require": {
        "hollodotme/fast-cgi-client": "^3.0",
        "monolog/monolog": "^3.0",
        "php": ">=8.1.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/finder": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "consolidation/self-update": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Geraldes",
            "email": "geraldes.pereira@con-vis.de"
        }
    ],
    "autoload": {
        "psr-4": {
            "CacheTool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CacheTool\\": "tests/"
        }
    },
    "bin": [
        "bin/cachetool"
    ]
}
